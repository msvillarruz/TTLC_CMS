# ─── Payload CMS ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=REPLACE_WITH_32_CHAR_RANDOM_STRING

# ─── Database ─────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URI=postgresql://ttlc_cms_user:REPLACE_PASSWORD@localhost:5432/ttlc_cms

# ─── URLs ────────────────────────────────────────────────────────────────────
# The CMS admin panel URL (set after DNS migration)
PAYLOAD_PUBLIC_SERVER_URL=https://cms.tinythinkers.edu.ph

# The Next.js frontend URL (for CORS + revalidation webhook)
NEXT_PUBLIC_SITE_URL=https://tinythinkers.edu.ph

# ─── Revalidation Webhook ────────────────────────────────────────────────────
# Shared secret between CMS and Next.js frontend
# Generate with: openssl rand -hex 32
REVALIDATION_SECRET=REPLACE_WITH_DIFFERENT_32_CHAR_RANDOM_STRING

# ─── Cloudflare R2 (media storage) ───────────────────────────────────────────
# From: Cloudflare Dashboard → R2 → Manage API tokens
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_KEY
S3_BUCKET=ttlc-media
S3_REGION=auto
# Public URL after custom domain is set up
S3_PUBLIC_URL=https://media.tinythinkers.edu.ph

# ─── Email (optional — for trial request notifications) ──────────────────────
# Uses Google Workspace SMTP via hello@tinythinkers.edu.ph
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hello@tinythinkers.edu.ph
SMTP_PASS=REPLACE_WITH_APP_PASSWORD
SMTP_FROM=Tiny Thinkers <hello@tinythinkers.edu.ph>

# ─── NODE ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3333
